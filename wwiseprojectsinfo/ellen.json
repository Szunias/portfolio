  "adaptive_ambience_waterfall": {
    "description": "Advanced cross-fading ambient system using State-driven Switch Container",
    "container_name": "SC_AMB",
    "behavior": "ContinuousPlayback with per-state fade times",
    "fade_in_time": 6.5,
    "fade_out_time": 6.5,

    "state_mappings": [
      {
        "state": "ExploreJungle (MusicZone)",
        "sounds": ["AMB_Harbor", "AMB_Jungle", "AMB_Wind_Desert_Gusts_01"],
        "description": "Outdoor jungle environment - plays harbor ambience, jungle sounds, and wind"
      },
      {
        "state": "EnteredMainChamber (MusicZone)",
        "sounds": ["AMB_CountrySide", "AMB_Wind_Desert_Gusts_02"],
        "description": "Large open chamber - countryside ambience with different wind layer"
      },
      {
        "state": "EnteredBuilding (MusicZone)",
        "sounds": ["AMB_Drone_Chakra_Space_01"],
        "description": "Interior space - single drone ambient layer"
      }
    ],

    "special_layer": {
      "name": "AMB_Addition",
