{
  "name": "igorszuniewicz-portfolio",
  "version": "1.0.0",
  "description": "Static HTML portfolio for Igor Szuniewicz — zero-dependency build pipeline.",
  "private": true,
  "scripts": {
    "build": "node build.cjs",
    "check": "node build.cjs --check",
    "test": "node --test tests/*.test.cjs",
    "preview": "node scripts/serve-dist.cjs",
    "inspect": "node scripts/inspect-site.cjs",
    "peaks": "node scripts/generate-peaks.cjs",
    "showreel:render": "node showreel/render.cjs",
    "showreel:preview": "node showreel/render-preview.cjs",
    "showreel:master": "node showreel/render.cjs --master-only",
    "showreel:qa": "node showreel/render.cjs --qa-only",
    "showreel:clean": "node showreel/render.cjs --clean",
    "showreel:sources": "node showreel/fetch-sources.cjs"
  },
  "engines": {
    "node": ">=22"
  }
}
