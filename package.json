{
  "name": "igorszuniewicz-portfolio",
  "version": "3.0.0",
  "description": "Portfolio website for Igor Szuniewicz - Audio Designer, Sound Designer & Composer",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "optimize": "node scripts/optimize-all.js",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:videos": "node scripts/optimize-videos.js",
    "clean": "node scripts/clean-duplicates.js",
    "analyze": "node scripts/analyze-bundle.js",
    "lint": "eslint assets/js/**/*.js",
    "format": "prettier --write \"assets/**/*.{js,css,html}\"",
    "check": "npm run lint && npm run test",
    "deploy": "npm run build && npm run deploy:prod",
    "deploy:prod": "rsync -avz --delete dist/ user@server:/var/www/igorszuniewicz.com/"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.3.0",
    "eslint": "^9.39.1",
    "js-beautify": "^1.15.4",
    "prettier": "^3.2.5",
    "sharp": "^0.33.2",
    "terser": "^5.27.0",
    "vite": "^5.1.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-imagemin": "^0.6.1",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/igorszuniewicz/portfolio.git"
  },
  "keywords": [
    "portfolio",
    "audio-design",
    "sound-design",
    "game-audio",
    "composer",
    "music"
  ],
  "author": "Igor Szuniewicz",
  "license": "MIT"
}
