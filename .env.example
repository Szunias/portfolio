# Build Environment
NODE_ENV=production

# Analytics Dashboard (if using real backend)
VITE_DEMO_MODE=true
VITE_API_ENDPOINT=/api/analytics.php

# Google Analytics (optional)
VITE_GA_TRACKING_ID=

